{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ridesathigo-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ridesathigodb",
      "database_id": "198279f6-e9de-4912-a993-07266c591d4c"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
