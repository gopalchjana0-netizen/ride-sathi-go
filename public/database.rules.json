      ".read": true,
      ".write": true,
      ".indexOn": [
        "status",
        "mobile",
        "customerPhone",
        "driverPhone",
        "time",
        "date",
        "city"
      ],
      "$bookingId": {
        ".read": true,
        ".write": true
      }
    },
    "rides": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "status",
